{
  "name": "expense-tracker",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "dev:server": "DATA_DIR=${DATA_DIR:-./data} STATIC_DIR=./dist HOST=${HOST:-127.0.0.1} PORT=${SERVER_PORT:-8098} tsx watch server/main.ts",
    "build": "tsc --noEmit && tsc --noEmit -p server && vite build && esbuild server/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=server/dist/main.mjs --log-level=warning",
    "build:server": "esbuild server/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=server/dist/main.mjs --log-level=warning",
    "start": "node server/dist/main.mjs",
    "preview": "vite preview --host",
    "check": "tsc --noEmit && tsc --noEmit -p server",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.22",
    "lucide-react": "^0.453.0",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^2.15.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^24.7.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.47",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3",
    "vite": "^7.1.7",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.34.6"
}
